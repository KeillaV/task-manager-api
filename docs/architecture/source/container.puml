@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()

Person(user, "User", "User of the system")

System_Boundary(system , "Task Manager") {
    Container(interface, "Desktop APP", "Kotlin Multiplatform", "Interface for users")
    Container(api, "Backend API", "Java Spring Boot", "Exposes endpoints to handle task operations, such as create, update, and view functions")
    Container(database, "Database", "PostgreSQL", "Stores task data")
}

user --> interface : user
interface --> api : sends requests
api --> database : reads and writes data

@enduml